<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="my_robot">

  <!-- Define some simple properties -->
  <xacro:property name="base_length" value="0.17"/>  <!-- meters -->
  <xacro:property name="base_width" value="0.18"/>   <!-- meters -->
  <xacro:property name="base_height" value="0.05"/>  <!-- meters -->
  <xacro:property name="lidar_height" value="0.15"/> <!-- meters -->
  <xacro:property name="camera_height" value="0.10"/> <!-- meters -->

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="Gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Lidar Link -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
      <origin xyz="0.0 0.0 ${lidar_height}" rpy="0 0 0"/>
      <material name="Red">
        <color rgba="1.0 0.0 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Camera Link -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <origin xyz="0.0 0.0 ${camera_height}" rpy="0 0 0"/>
      <material name="Blue">
        <color rgba="0.0 0.0 1.0 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Joints -->

  <!-- Lidar Joint -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0.0 ${lidar_height}" rpy="0 0 0"/>
  </joint>

  <!-- Camera Joint -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.0 0.0 ${camera_height}" rpy="0 0 0"/>
  </joint>

</robot>